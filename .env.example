# Local MongoDB. Copy this file to `.env.local` and adjust if needed.
#
# The app works without it: when no database is reachable, documents are saved
# to the browser's localStorage instead and the UI says so. Set this to get
# documents that persist beyond one browser.
#
#   brew install mongodb-community && brew services start mongodb-community
#   # or: docker run -d -p 27017:27017 --name typesketch-mongo mongo:7
#
# Version history writes `documents` and `versions` together in a transaction,
# which needs a replica set. A standalone mongod cannot do transactions, so
# history is skipped there — Atlas and `mongo:7 --replSet` both support it.
MONGODB_URI=mongodb://127.0.0.1:27017/typesketch
